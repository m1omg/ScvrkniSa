<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Shrink" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/text_primary</item>
        <item name="colorSecondary">@color/accent_2</item>
        <item name="colorOnSecondary">@android:color/white</item>
        <item name="colorSurface">@color/bg_top</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/glass_stroke_light</item>
        <item name="colorControlNormal">@color/text_primary</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/bg_top</item>
        <item name="android:windowBackground">@color/bg_top</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_bars</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:enforceStatusBarContrast">false</item>
        <item name="materialButtonStyle">@style/Widget.Shrink.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.Shrink.Button.Glass</item>
        <item name="chipStyle">@style/Widget.Shrink.Chip</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.Shrink.Dialog</item>
    </style>

    <style name="Widget.Shrink.Button" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="cornerRadius">26dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:background">@drawable/bg_primary_button</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="iconTint">@android:color/white</item>
    </style>

    <style name="Widget.Shrink.Button.Glass" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="iconTint">@color/text_primary</item>
        <item name="strokeColor">@color/glass_stroke_light</item>
        <item name="backgroundTint">@color/glass_fill</item>
    </style>

    <style name="Widget.Shrink.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipBackgroundColor">@color/chip_background</item>
        <item name="chipStrokeColor">@color/glass_stroke_light</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="checkedIconTint">@color/accent</item>
    </style>

    <style name="ThemeOverlay.Shrink.Dialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="colorPrimary">@color/accent</item>
    </style>

    <style name="Widget.Shrink.NavItem" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">22dp</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/nav_item_text</item>
        <item name="android:drawableTint">@color/nav_item_text</item>
        <item name="android:background">@drawable/bg_nav_item</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Shrink.Pill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">12dp</item>
        <item name="android:background">@drawable/bg_pill</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Shrink.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Text.Shrink.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="Text.Shrink.Secondary" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>
